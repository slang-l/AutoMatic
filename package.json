{
  "name": "automatic",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": "^20.12.0 || >=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @automatic/web --filter @automatic/api dev",
    "dev:web": "pnpm --filter @automatic/web dev",
    "dev:api": "pnpm --filter @automatic/api dev",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @automatic/api db:migrate",
    "build": "pnpm --filter \"./apps/**\" --if-present build",
    "typecheck": "pnpm --filter \"./apps/**\" --if-present typecheck",
    "test": "pnpm --filter \"./apps/**\" --if-present test && pnpm ops:test",
    "ops:test": "node --test scripts/test/cicd.test.mjs",
    "cicd": "node scripts/cicd.mjs",
    "ci:run": "node scripts/cicd.mjs ci",
    "ci:local": "node scripts/test-linux-ci.mjs",
    "deploy:prod": "node scripts/cicd.mjs deploy",
    "release": "node scripts/cicd.mjs release",
    "rollback": "node scripts/cicd.mjs rollback",
    "deploy:status": "node scripts/cicd.mjs status",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "vite": "6.4.3"
  }
}
