NODE_ENV=development
HOST=0.0.0.0
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=postgresql://automatic:automatic@localhost:5432/automatic

# 仅用于本地开发；每个部署环境都必须生成独立的随机密钥。
JWT_ACCESS_SECRET=replace-this-development-secret-with-at-least-32-random-characters
JWT_ISSUER=automatic-api
JWT_AUDIENCE=automatic-web
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# 可选：通过 Resend 投递注册验证码。真实值只写入 .env，不要提交。
RESEND_API_KEY=
RESEND_FROM=

# 仅 NODE_ENV=development 可用。启动 API 时会幂等创建/校正此最高权限账号。
# 可设为 false 关闭；生产环境禁止启用。
DEV_ADMIN_ENABLED=true
DEV_ADMIN_EMAIL=admin@qq.com
DEV_ADMIN_PASSWORD=123456
DEV_ADMIN_NAME=系统管理员
